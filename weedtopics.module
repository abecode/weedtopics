#\DeclareLyXModule{Weed Topics}
#DescriptionBegin
#Adds selectable LyX styles for weed-topic chapter, section, subsection, and special-topic markers.
#DescriptionEnd

AddToPreamble
  \usepackage{weedtopics}
EndPreamble

Style Weedy_Chapter
  Category              "Weed Topics"
  Margin                Dynamic
  LatexType             Command
  LatexName             slightlyweedchapter
  LabelType             Static
  LabelString           "Weedy Chapter"
  KeepEmpty             0
  Font
    Series              Bold
    Size                Huge
  EndFont
End

Style Weedier_Chapter
  Category              "Weed Topics"
  Margin                Dynamic
  LatexType             Command
  LatexName             weedierchapter
  LabelType             Static
  LabelString           "Weedier Chapter"
  KeepEmpty             0
  Font
    Series              Bold
    Size                Huge
  EndFont
End

